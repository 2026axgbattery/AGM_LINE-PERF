# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vitest-scratch/
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 디자인 시스템 원본(../sebang_design_system_2/)에서 복사된 파일 — npm install(postinstall)이 재생성함
/public/design/

# SQLite 데이터 파일 (WAL 모드 부산물 -shm/-wal 포함)
/data/*.sqlite
/data/*.sqlite-shm
/data/*.sqlite-wal
